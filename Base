CREATE TABLE Usuarios (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre          TEXT NOT NULL,
    usuario         TEXT NOT NULL UNIQUE,
    correo          TEXT NOT NULL UNIQUE,
    contrasena_hash TEXT NOT NULL,
    fecha_registro  TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE TABLE Tematicas (
    id      INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre  TEXT NOT NULL UNIQUE
);

CREATE TABLE Letras (
    id     INTEGER PRIMARY KEY AUTOINCREMENT,
    letra  TEXT NOT NULL UNIQUE CHECK (length(letra) = 1)
);

CREATE TABLE Dificultades (
    id               INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre           TEXT NOT NULL UNIQUE,
    tiempo_segundos  INTEGER NOT NULL CHECK (tiempo_segundos > 0)
);

CREATE TABLE Preguntas (
    id                 INTEGER PRIMARY KEY AUTOINCREMENT,
    id_letra           INTEGER NOT NULL,
    id_tematica        INTEGER NOT NULL,
    enunciado          TEXT NOT NULL,
    respuesta_correcta TEXT NOT NULL,
    tipo               TEXT NOT NULL DEFAULT 'Empieza con'
                       CHECK (tipo IN ('Empieza con', 'Contiene')),
    FOREIGN KEY (id_letra)    REFERENCES Letras(id),
    FOREIGN KEY (id_tematica) REFERENCES Tematicas(id)
);

CREATE TABLE Roscos (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    id_tematica  INTEGER,
    nombre       TEXT NOT NULL,
    FOREIGN KEY (id_tematica) REFERENCES Tematicas(id)
);

CREATE TABLE RoscoPreguntas (
    id_rosco     INTEGER NOT NULL,
    id_pregunta  INTEGER NOT NULL,
    orden        INTEGER NOT NULL,
    PRIMARY KEY (id_rosco, id_pregunta),
    FOREIGN KEY (id_rosco)    REFERENCES Roscos(id)    ON DELETE CASCADE,
    FOREIGN KEY (id_pregunta) REFERENCES Preguntas(id)
);

CREATE TABLE Partidas (
    id             INTEGER PRIMARY KEY AUTOINCREMENT,
    id_usuario     INTEGER,
    id_rosco       INTEGER NOT NULL,
    id_dificultad  INTEGER NOT NULL,
    fecha_inicio   TEXT NOT NULL DEFAULT (datetime('now')),
    fecha_fin      TEXT,
    aciertos       INTEGER NOT NULL DEFAULT 0,
    errores        INTEGER NOT NULL DEFAULT 0,
    pasadas        INTEGER NOT NULL DEFAULT 0,
    puntaje        INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (id_usuario)    REFERENCES Usuarios(id),
    FOREIGN KEY (id_rosco)      REFERENCES Roscos(id),
    FOREIGN KEY (id_dificultad) REFERENCES Dificultades(id)
);

CREATE TABLE Respuestas (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    id_partida      INTEGER NOT NULL,
    id_pregunta     INTEGER NOT NULL,
    respuesta_dada  TEXT,
    resultado       TEXT NOT NULL
                    CHECK (resultado IN ('acierto', 'error', 'pasapalabra')),
    FOREIGN KEY (id_partida)  REFERENCES Partidas(id)  ON DELETE CASCADE,
    FOREIGN KEY (id_pregunta) REFERENCES Preguntas(id)
);

